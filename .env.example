# FieldDesk Environment Configuration Example
# Copy to .env for local overrides

# Security
SECRET_KEY=django-insecure-fielddesk-assessment-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Databases & Cache
DATABASE_URL=postgres://fielddesk:fielddesk@localhost:5432/fielddesk
REDIS_URL=redis://localhost:6379/0

# Storage Limit (100 MB per org default)
STORAGE_LIMIT_BYTES=104857600

# Mock Notification Provider Mode: success | temp_fail | perm_fail | random
MOCK_PROVIDER_MODE=success

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000
